# GlitchTip configuration. Copy to .env and fill in. The .env file is
# gitignored. Generate the two secrets with: openssl rand -hex 32

# Postgres password for GlitchTip's bundled database (any strong value).
POSTGRES_PASSWORD=

# Django secret key. MUST be set; keep it stable or existing sessions break.
SECRET_KEY=

# Public base URL GlitchTip uses to build DSNs and links. For the default
# localhost + SSH-tunnel setup leave as-is; for a reverse-proxied subdomain
# set e.g. https://glitchtip.example.com
GLITCHTIP_DOMAIN=http://localhost:8000

# Host port the dashboard binds to (127.0.0.1 only, see docker-compose.yml).
GLITCHTIP_PORT=8000

# Let the first visitor self-register the initial admin user, then turn this
# off (set to False and `docker compose up -d`) to close registration.
ENABLE_OPEN_USER_REGISTRATION=True

# Email. `consolemail://` just logs emails (fine for a single-admin install).
# For real invites use an SMTP URL, e.g. smtp://user:pass@smtp.host:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=glitchtip@example.com

# Resource tuning for small hosts.
CELERY_WORKER_CONCURRENCY=1
WEB_CONCURRENCY=2
